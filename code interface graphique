import numpy as np
import matplotlib.pyplot as plt
import csv
import tkinter as tk
from tkinter import ttk

## ==========================
##     FONCTIONS EXISTANTES
## ==========================

fichier = 'test.csv'

def lectureMesures(nomFich):
    f = open(nomFich)
    fcsv = csv.reader(f, delimiter=';')

    for E in fcsv:
        break
    E = E[1:]

    LL = []
    I = []
    for ligne in fcsv:
        for i in range(len(ligne)):
            ligne[i] = ligne[i].replace(',','.')
        I.append(ligne[0])
        LL.append(ligne[1:])
    M = np.array(LL, dtype=float)
    f.close()
    return M, I, E


def recuperation_ligne(g):
    tableau_ligne = []
    with open(fichier, newline='') as csvfile:
        lecteur = csv.reader(csvfile)
        entetes = next(lecteur)
        for row in lecteur:
            if row[0] == g:
                tableau_ligne.append(row)
    return [entetes] + tableau_ligne


def valeur_glacier_annee_x(glacier, annee):
    tableau = recuperation_ligne(glacier)
    num_col = tableau[0].index(annee)
    return tableau[1][num_col]


def evolution_glacier_intervalle(glacier, annee1, annee2):
    tableau = recuperation_ligne(glacier)
    X = tableau[0][1:]
    Y = tableau[1][1:]

    # Transformer string → float
    Y = [float(v) for v in Y]

    # Trouver index années
    i1 = X.index(annee1)
    i2 = X.index(annee2)

    # Extraire intervalle
    X_int = X[i1:i2+1]
    Y_int = Y[i1:i2+1]

    # Tracer
    plt.plot(X_int, Y_int, marker="o")
    plt.title(f"Évolution du glacier {glacier} ({annee1} → {annee2})")
    plt.xlabel("Années")
    plt.ylabel("Valeurs")
    plt.grid()
    plt.show()


## ==========================
##     INTERFACE TKINTER
## ==========================

# Charger la liste des glaciers et des années
M, glaciers, annees = lectureMesures(fichier)


fen = tk.Tk()
fen.title("Visualisation glaciers")


## --- Labels ---
tk.Label(fen, text="Sélection du glacier :").grid(row=0, column=0, padx=10, pady=5)
tk.Label(fen, text="Année de début :").grid(row=1, column=0, padx=10, pady=5)
tk.Label(fen, text="Année de fin :").grid(row=2, column=0, padx=10, pady=5)


## --- Menus déroulants ---
liste_glaciers = ttk.Combobox(fen, values=glaciers, state="readonly")
liste_glaciers.grid(row=0, column=1)
liste_glaciers.current(0)

liste_annee1 = ttk.Combobox(fen, values=annees, state="readonly")
liste_annee1.grid(row=1, column=1)
liste_annee1.current(0)

liste_annee2 = ttk.Combobox(fen, values=annees, state="readonly")
liste_annee2.grid(row=2, column=1)
liste_annee2.current(len(annees)-1)


## --- Fonction déclenchée par le bouton ---
def afficher_graphique():
    g = liste_glaciers.get()
    a1 = liste_annee1.get()
    a2 = liste_annee2.get()
    evolution_glacier_intervalle(g, a1, a2)


## --- Bouton ---
btn = tk.Button(fen, text="Afficher évolution", command=afficher_graphique)
btn.grid(row=3, column=0, columnspan=2, pady=10)


fen.mainloop()